{
  "name": "hatstand",
  "version": "0.1.0",
  "private": true,
  "description": "Agent orchestrator for contractors and freelancers: a workspace for every client, with areas of work, and context kept separate.",
  "license": "Apache-2.0",
  "author": "jcvargasGit",
  "homepage": "https://github.com/jcvargasGit/hatstand#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcvargasGit/hatstand.git"
  },
  "bugs": {
    "url": "https://github.com/jcvargasGit/hatstand/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "node scripts/dev.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/dev.mjs preview",
    "install:app": "node scripts/install-app.mjs",
    "dev:sync": "node scripts/dev-sync.mjs",
    "dev:sandbox": "node scripts/dev-sandbox.mjs",
    "release": "node scripts/release.mjs",
    "test:packaged": "node tests/e2e/packaged.mjs",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node tests/e2e/run.mjs",
    "lint": "oxlint",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "6.0.2",
    "lucide-react": "^1.61.0",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^26.1.0",
    "node-gyp": "^11.0.0",
    "oxlint": "~1.89.0",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
